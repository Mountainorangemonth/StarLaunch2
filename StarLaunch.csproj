<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\favicon.ico</ApplicationIcon>
    <!-- 默认管理员权限：清单里是 requireAdministrator，双击就会弹 UAC。
         想改回普通权限只需改 app.manifest 里的 requestedExecutionLevel。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

	<ItemGroup>
		<!-- 网页资源：按目录通配编进程序集，宿主把 URL 路径里的 / 换成 .
		     就是资源名（/js/00-core.js → StarLaunch.WebAssets.js.00-core.js）。
		     新增模块文件不需要再改这里。 -->
		<EmbeddedResource Include="WebAssets\**\*.html" />
		<EmbeddedResource Include="WebAssets\**\*.css" />
		<EmbeddedResource Include="WebAssets\**\*.js" />

		<!-- 图片等静态资源：用户壁纸由宿主扫描外部 wallpapers 文件夹，
		     exe 同级目录不可写时退回 %LOCALAPPDATA%\StarLaunch\wallpapers -->
		<EmbeddedResource Include="WebAssets\assets\**\*" />
		<Content Include="Resources\favicon.ico" />

		<!-- 自定义主页模板：配置目录里没有 Custom.xaml 时用它生成一份，
		     资源名固定为 StarLaunch.Resources.Custom.xaml（见 Services\CustomHome.cs）。
		     必须先把它从 WPF 默认的 Page 通配里摘出来：UseWPF 会把 **\*.xaml 全都
		     当页面编译，而这份模板里有 local:MyCard 这种只有 PCL 才认识的控件。 -->
		<Page Remove="Resources\Custom.xaml" />
		<EmbeddedResource Include="Resources\Custom.xaml" />

		<!-- 开发时放进 wallpapers 的图片会复制到输出目录，方便直接看效果。
		     用 Update 而不是 Include，避免和 SDK 默认 None 项重复。 -->
		<!-- 开发时复制到输出目录方便看效果；发布时不带（运行时宿主会自己建这个文件夹） -->
		<None Update="wallpapers\**\*" CopyToOutputDirectory="PreserveNewest"
		      Condition="'$(_IsPublishing)' != 'true'" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- 发布默认走单文件：只要在跑 dotnet publish，就自动带上这套参数，
       不用再记 -p:PublishSingleFile=true 之类的开关。
       Condition 只在发布时成立（dotnet build / VS 的「生成」不受影响，
       调试时还是普通的 bin\Debug 输出，热重载和断点照常）。

       几项的取舍：
         IncludeNativeLibrariesForSelfExtract  WebView2 的原生库塞不进 exe 映像，
                                               运行时解到 %TEMP%\.net，缺了它就报找不到 DLL
         EnableCompressionInSingleFile         138 MB → 63 MB，换几百毫秒解压时间
         DebugType=none                        发布版不带 pdb
       绝对不要开 PublishTrimmed：WPF / WebView2 大量走反射，裁剪后运行时才炸。 -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

</Project>
